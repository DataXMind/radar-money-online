*.py text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Preserve request bytes, test reports and manifest hashes across Git checkouts.
artifacts/** -text -whitespace
tests/fixtures/** -text -whitespace
*.body binary
# Agent/hook bundle hashes must survive checkout without newline conversion.
.codex/** -text
# Preserve the exact approved configuration bytes alongside the run manifest.
config/production_v1.json -text
config/approvals/** -text -whitespace
